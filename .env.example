# ─────────────────────────────────────────────
# Jarwis — пример конфигурации окружения
# Скопируйте в .env и заполните под себя: cp .env.example .env
# ─────────────────────────────────────────────

# База URL бэкенда. Оставьте пустым — приложение работает на мок-API.
VITE_API_URL=

# Публичные ключи платёжной системы
VITE_PAYMENT_PROVIDER=stub
VITE_PAYMENT_PUBLIC_KEY=

# Авторизация
VITE_GOOGLE_CLIENT_ID=

# Админ-панель
VITE_ADMIN_EMAIL=admin@jarwis.gg
